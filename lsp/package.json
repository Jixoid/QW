{
  "name": "qw-lsp-client",
  "displayName": "QW LSP Client",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:qw"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "qw",
        "aliases": [
          "QW"
        ],
        "extensions": [
          ".qw"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  }
}
