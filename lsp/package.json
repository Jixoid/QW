{
  "name": "qw-vscode",
  "displayName": "QW Lang",
  "description": "Word mapping based syntax highlighter and language support for QW programming language.",
  "version": "0.1.0",
  "publisher": "qaos",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:qw",
    "onCommand:qw.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qw",
        "aliases": ["QW", "qw"],
        "extensions": [".qw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qw",
        "scopeName": "source.qw",
        "path": "./syntaxes/qw.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "QW",
      "properties": {
        "qw.lsp.serverPath": {
          "type": "string",
          "default": "qwd.debug",
          "description": "Path to the QW language server executable"
        }
      }
    },
    "commands": [
      {
        "command": "qw.restartServer",
        "title": "Restart Language Server",
        "category": "QW"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "qw",
        "scopes": {
          "keyword.declaration": [
            "keyword.declaration.qw",
            "storage.type"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "node test.js"
  }
}
