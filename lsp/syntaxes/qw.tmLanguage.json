{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "QW",
  "scopeName": "source.qw",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#type_declarations" },
    { "include": "#impl_declarations" },
    { "include": "#variable_declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#parameters" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.qw",
          "match": "//.*$"
        },
        { "include": "#block_comment" }
      ]
    },
    "block_comment": {
      "name": "comment.block.qw",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        { "include": "#block_comment" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.qw",
          "match": "\\b(fun|task|init|fini)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.qw" },
            "2": { "name": "entity.name.function.qw" }
          }
        },
        {
          "name": "meta.function.call.qw",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.qw" }
          }
        }
      ]
    },
    "type_declarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.qw",
          "match": "\\b(struct|enum|iface|trait|flags|type)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.qw" },
            "2": { "name": "entity.name.type.qw" }
          }
        }
      ]
    },
    "impl_declarations": {
      "patterns": [
        {
          "name": "meta.impl.declaration.qw",
          "match": "\\b(impl)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(:)\\s*([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.qw" },
            "2": { "name": "entity.name.type.qw" },
            "3": { "name": "keyword.operator.qw" },
            "4": { "name": "entity.name.type.qw" }
          }
        }
      ]
    },
    "variable_declarations": {
      "patterns": [
        {
          "name": "meta.variable.declaration.qw",
          "match": "\\b(let|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.qw" },
            "2": { "name": "variable.other.declaration.qw" }
          }
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.qw",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=(?:\\s*,\\s*[a-zA-Z_][a-zA-Z0-9_]*)*\\s*:)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.qw",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.qw",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.qw",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.qw",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.qw",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qw",
          "match": "\\b(if|ef|else|match|loop|while|for|in|ret|return|break|continue|die)\\b"
        },
        {
          "name": "keyword.declaration.qw",
          "match": "\\b(fun|task|init|fini|let|var|using|type|struct|iface|trait|enum|flags|impl|generic|mod|use|requires|static|const|mut|imm|self|Self)\\b"
        },
        {
          "name": "keyword.other.visibility.qw",
          "match": "\\b(pub|priv|prot|crate|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.qw",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|fsize|bool|str|char|void|type)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.qw",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.qw",
          "match": "(->|=>|<-|<<=|>>=|<<\\||\\|>>|<<|>>|&&=|\\|\\|=|^\\^=|&&|\\|\\||\\^\\^|&=|\\|=|^=|\\+=|-=|\\*=|/=|%=|==|!=|>=|<=|::|\\.\\.|[+\\-*/%=!<>&|^~?:;,#@])"
        }
      ]
    }
  }
}
