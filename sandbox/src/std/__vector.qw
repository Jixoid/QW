
struct vector<T> {
  data: T^;
  size: u64;
  cap: u64;

  init() {
    self.size = 0;
    self.cap = 0;
    self.data = null;
  }

  fini() {
    if (self.cap > 0) {
      sys::heap::dispose(sys::cast<ptr>(self.data), self.cap * 8);
      self.data = null;
      self.cap = 0;
      self.size = 0;
    }
  }

}
