[[symbol:bare]]
fun puts(s: char^) -> i32;

iface Animal {
  fun speak();
}

struct Dog: Animal {
  fun speak() {
    puts("Hav");
  }
}

struct Cat: Animal {
  fun speak() {
    puts("Miyav");
  }
}

fun main() -> void {
  var d: Dog;
  var c: Cat;
  
  var a1: Animal = d;
  var a2: Animal = c;
  
  a1.speak();
  a2.speak();
}
