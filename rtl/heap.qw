
// C functions
[[symbol:bare, calling:cdecl]]
fun aligned_alloc(alignment, size: usize) -> ptr;

[[symbol:bare, calling:cdecl]]
fun free_aligned_sized(p: ptr; alignment, size: usize) -> void;



// sys::heap::alloc
[[rtl]]
fun alloc(align, size: usize) -> ptr {
  ret aligned_alloc(align, size);
}

// sys::heap::dispose
[[rtl]]
fun dispose(p: ptr; align, size: usize) -> bool {
  free_aligned_sized(p, align, size);
}

// sys::heap::realloc
[[rtl]]
fun realloc(p: ptr; align, old_size, new_size: usize) -> ptr {
	free_aligned_sized(p, align, old_size);

	var new_p: ptr = aligned_alloc(align, new_size);
	if (new_p == null) {
		ret null;
	}

	ret new_p;
}
