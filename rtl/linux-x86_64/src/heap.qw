
[[symbol:bare, calling:cdecl]]
fun malloc(size: usize) -> ptr;

[[symbol:bare, calling:cdecl]]
fun free(p: ptr);

[[symbol:bare, calling:cdecl]]
fun realloc(p: ptr; size: usize) -> ptr;




[[rtl]]
fun alloc(align, size: usize) -> ptr {
  ret malloc(size);
}


[[rtl]]
fun dispose(p: ptr; align, size: usize) -> void {
  free(p);
}


[[rtl]]
fun realloc(p: ptr; align, old_size, new_size: usize) -> ptr {
  ret realloc(p, new_size);
}
